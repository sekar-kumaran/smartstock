*.swp
*.swo

# MacOS
.DS_Store

# SmartStock specific
/data/
/outputs/
*.pkl
*.joblib
*.csv
# However, we DO want to keep the offline models if they are checked into git.
# Wait, for this repo, we probably want the artifacts to be committed so the app works in cloud.
# So we will exclude the model artifacts from gitignore, but ignore big data.
# Let's ignore actual large datasets.
/data/*.csv
!/data/sample_dataset.csv
